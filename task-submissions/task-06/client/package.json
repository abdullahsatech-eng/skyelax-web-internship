{
  "name": "fixflow-client",
  "version": "1.0.0",
  "private": true,
  "description": "FixFlow web client (React, TypeScript, Vite) for SKYELAX Web Development Internship Task 06",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
