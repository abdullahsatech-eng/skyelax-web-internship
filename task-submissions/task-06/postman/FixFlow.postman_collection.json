              "  pm.expect(body).to.have.property(\"error\");",
              "  pm.expect(body.error).to.have.property(\"code\", \"VALIDATION_ERROR\");",
              "  pm.expect(body.error.message).to.be.a(\"string\");",
              "  pm.expect(body).to.not.have.property(\"data\");",
              "});",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Details name the offending field 'title'\", () => {",
              "  const fields = pm.response.json().error.details.map((d) => d.field);",
