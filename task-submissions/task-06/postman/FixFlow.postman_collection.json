{
  "info": {
    "name": "FixFlow API",
    "description": "Task 06 API tests for the FixFlow service request API. Run the requests in order (use the Collection Runner): request 02 stores {{requestId}} for the ones after it. Set the baseUrl variable to the API you want to test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Reports database up\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.status).to.eql(\"ok\");",
              "  pm.expect(body.data.database).to.eql(\"up\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 Create request (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Returns the created resource in { data }\", () => {",
              "  pm.expect(body.data.id).to.match(/^[0-9a-f]{24}$/);",
              "  pm.expect(body.data.title).to.eql(\"Postman test: projector will not turn on\");",
              "  pm.expect(body.data.status).to.eql(\"open\");",
              "  pm.expect(body.data.requesterEmail).to.eql(\"postman.tester@example.com\");",
              "  pm.expect(body.data.createdAt).to.be.a(\"string\");",
              "  pm.expect(body.data.updatedAt).to.be.a(\"string\");",
              "});",
              "pm.test(\"Location header points at the new resource\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(body.data.id));",
              "pm.collectionVariables.set(\"requestId\", body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "requests"
          ]
        },
        "description": "Creates a request and stores its id in the requestId collection variable.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman test: projector will not turn on\",\n  \"description\": \"Created by the FixFlow Postman collection to verify the API.\",\n  \"category\": \"it\",\n  \"priority\": \"high\",\n  \"requesterName\": \"Postman Tester\",\n  \"requesterEmail\": \"Postman.Tester@Example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 List requests (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"data is an array and meta is present\", () => {",
              "  pm.expect(body.data).to.be.an(\"array\");",
              "  pm.expect(body.meta).to.include.keys(\"page\", \"limit\", \"total\", \"totalPages\", \"statusCounts\");",
              "});",
              "pm.test(\"The request created earlier is listed\", () => {",
              "  const ids = body.data.map((r) => r.id);",
              "  pm.expect(ids).to.include(pm.collectionVariables.get(\"requestId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/requests?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "requests"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "04 List with filters (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Every result matches the filters\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an(\"array\");",
              "  body.data.forEach((r) => {",
              "    pm.expect(r.status).to.eql(\"open\");",
              "    pm.expect(r.priority).to.eql(\"high\");",
              "    pm.expect(r.title.toLowerCase()).to.include(\"postman\");",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/requests?status=open&priority=high&search=Postman",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "requests"
          ],
          "query": [
            {
              "key": "status",
              "value": "open"
            },
            {
              "key": "priority",
              "value": "high"
            },
            {
              "key": "search",
              "value": "Postman"
            }
          ]
        }
      }
    },
