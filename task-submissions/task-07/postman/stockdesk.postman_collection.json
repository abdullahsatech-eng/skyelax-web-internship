          "raw": "{\n  \"name\": \"Postman Desk Lamp\",\n  \"sku\": \"PM-LAMP-001\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"supplierId\": \"{{supplierId}}\",\n  \"price\": \"24.50\",\n  \"quantity\": 12\n}",
