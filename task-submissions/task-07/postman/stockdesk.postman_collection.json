{
  "info": {
    "name": "StockDesk API (Task 07)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order. Start the API first (npm run dev in /server) and run npm run db:setup once so categories and suppliers exist. Use a test database, not data you care about."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Expected: 200. database should be 'connected'."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('database connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 List categories (sets categoryId)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        },
        "description": "Expected: 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data; pm.test('has categories', () => pm.expect(d.length).to.be.above(0)); pm.collectionVariables.set('categoryId', d[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List suppliers (sets supplierId)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/suppliers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "suppliers"
          ]
        },
        "description": "Expected: 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data; pm.test('has suppliers', () => pm.expect(d.length).to.be.above(0)); pm.collectionVariables.set('supplierId', d[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Expected: 201.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Desk Lamp\",\n  \"sku\": \"PM-LAMP-001\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"supplierId\": \"{{supplierId}}\",\n  \"price\": \"24.50\",\n  \"quantity\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const p = pm.response.json().data; pm.collectionVariables.set('productId', p.id); pm.test('price kept as 24.50', () => pm.expect(p.price).to.eql('24.50'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 List products (contains new product)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Expected: 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('contains product', () => pm.expect(pm.response.json().data.some(p => p.id === pm.collectionVariables.get('productId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Get one product",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Expected: 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('sku matches', () => pm.expect(pm.response.json().data.sku).to.eql('PM-LAMP-001'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Update product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Expected: 200.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Desk Lamp\",\n  \"sku\": \"PM-LAMP-001\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"supplierId\": \"{{supplierId}}\",\n  \"price\": \"30\",\n  \"quantity\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('updated', () => { const p = pm.response.json().data; pm.expect(p.quantity).to.eql(3); pm.expect(p.price).to.eql('30.00'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Re-read after update",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Expected: 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('update persisted', () => pm.expect(pm.response.json().data.quantity).to.eql(3));"
            ]
          }
        }
      ]
    },
